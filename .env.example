# Pocket ID OIDC client
POCKETID_ISSUER=https://id.example.com
POCKETID_CLIENT_ID=haken
POCKETID_CLIENT_SECRET=replace-with-your-client-secret
POCKETID_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Optional: restrict login to these Pocket ID email addresses
# POCKETID_ALLOWED_EMAILS=you@example.com,another@example.com

# Optional app settings
# DATA_DIR=./data
# HOST=127.0.0.1
# PORT=3000
# COOKIE_SECURE=false
